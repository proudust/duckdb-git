# name: test/sql/libgit/output_git_branch.test
# description: git_branch table function (libgit backend)
# group: [git]

require duckdb_git

# Default: local branches only
query I
SELECT count(*) FROM git_branch('./test/fixtures/parity.git');
----
2

query III
SELECT name, commit_id, is_head
FROM git_branch('./test/fixtures/parity.git')
ORDER BY refname;
----
master	abe0518abd296b9b9a45755e12ec6ebec26c17a7	true
side	28264d80ac316c97deb80c3ee52721ed6451e4b2	false

# all_branches=true includes remote-tracking branches (branch -a style names)
query I
SELECT count(*) FROM git_branch('./test/fixtures/parity.git', all_branches=true);
----
4

query II
SELECT name, commit_id
FROM git_branch('./test/fixtures/parity.git', all_branches=true)
WHERE name LIKE 'remotes/%'
ORDER BY name;
----
remotes/origin/HEAD	42e16c94127de3a9363f8a6f14fa5ca85856d8b4
remotes/origin/main	42e16c94127de3a9363f8a6f14fa5ca85856d8b4

# master tracks origin/main (ahead 6, behind 0); side tracks missing upstream (gone)
query IIII
SELECT upstream, upstream_ahead, upstream_behind, upstream_gone
FROM git_branch('./test/fixtures/parity.git')
WHERE name = 'master';
----
remotes/origin/main	6	0	false

query II
SELECT upstream, upstream_gone
FROM git_branch('./test/fixtures/parity.git')
WHERE name = 'side';
----
remotes/origin/gone	true

# push is @{push} / %(push); under push.default=simple (default) master→main is unresolved
query I
SELECT push
FROM git_branch('./test/fixtures/parity.git')
WHERE name = 'master';
----
NULL

query I
SELECT push
FROM git_branch('./test/fixtures/parity.git')
WHERE name = 'side';
----
NULL

# Remote-tracking rows never resolve push
query I
SELECT DISTINCT push IS NULL
FROM git_branch('./test/fixtures/parity.git', all_branches=true)
WHERE name LIKE 'remotes/%';
----
true
