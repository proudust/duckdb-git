# name: test/sql/libgit/remote_url.test
# description: git_log with remote HTTP(S) URL (libgit backend)
# group: [git]

require duckdb_git

# Explicit backend; revision omitted so HEAD must resolve after clone
query I
SELECT count(*) FROM git_log('https://github.com/proudust/duckdb-git.git', max_count=3, backend='libgit');
----
3

# Tip of unresolved HEAD carries the default-branch decorate
# (empty decorate here would mean set_head never pointed HEAD at a fetched ref)
query I
SELECT list_contains(decorate, 'main')
FROM git_log('https://github.com/proudust/duckdb-git.git', max_count=1, backend='libgit');
----
true

# HEAD tip matches the remote default branch tip
query I
SELECT (
  SELECT commit_id FROM git_log('https://github.com/proudust/duckdb-git.git', max_count=1, backend='libgit')
) = (
  SELECT commit_id FROM git_log('https://github.com/proudust/duckdb-git.git', revision='main', max_count=1, backend='libgit')
);
----
true

# Second query exercises fetch against the existing cache
query I
SELECT count(*) FROM git_log('https://github.com/proudust/duckdb-git.git', max_count=3, backend='libgit');
----
3

# Embedded credentials are rejected (anonymous HTTP(S) only)
statement error
SELECT count(*) FROM git_log('https://user:token@example.com/repo.git', max_count=1, backend='libgit');
----
embedded credentials
