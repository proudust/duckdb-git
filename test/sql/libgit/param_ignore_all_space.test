# name: test/sql/libgit/param_ignore_all_space.test
# description: ignore_all_space parameter diff line counts (libgit backend)
# group: [git]

require duckdb_git

# Mixed whitespace + content change: normal numstat counts both
query II
SELECT change.add_lines, change.del_lines FROM (
  SELECT unnest(file_changes) as change
  FROM git_log('./test/fixtures/parity.git',
               revision='whitespace',
               max_count=1, ignore_all_space=false)
) WHERE change.path = 'space.txt';
----
2	2

# ignore_all_space drops indent-only hunks but keeps the real line change (git log -w)
query II
SELECT change.add_lines, change.del_lines FROM (
  SELECT unnest(file_changes) as change
  FROM git_log('./test/fixtures/parity.git',
               revision='whitespace',
               max_count=1, ignore_all_space=true)
) WHERE change.path = 'space.txt';
----
1	1
