# name: test/sql/libgit/output_contained.test
# description: contained_branches / contained_tags columns (libgit backend)
# group: [git]

require duckdb_git

# decorate is refs pointing at this commit; contained_tags is all tags that contain it as an ancestor.
# v1 tip: decorate=[v1], but contained_tags includes every tag whose history reaches this commit.
query I
SELECT list_sort(decorate)
FROM git_log('./test/fixtures/parity.git',
             revision='v1', max_count=1);
----
[v1]

query I
SELECT list_sort(contained_tags)
FROM git_log('./test/fixtures/parity.git',
             revision='v1', max_count=1);
----
[amended, binary, deleted, gitlink-bump, left, merged, multipath, note, padded-author, rename, right, typechange, v1, whitespace]

# Branches containing the root commit (symbolic origin/HEAD excluded)
query I
SELECT list_sort(contained_branches)
FROM git_log('./test/fixtures/parity.git',
             revision='v1', max_count=1);
----
[master, origin/main, side]

# Bare origin/HEAD alias is never included in contained_branches
query I
SELECT list_contains(contained_branches, 'origin/HEAD')
FROM git_log('./test/fixtures/parity.git',
             revision='v1', max_count=1);
----
false

# decorate='full' format is reused for full ref paths in contained_* too
query II
SELECT list_sort(contained_tags), list_sort(contained_branches)
FROM git_log('./test/fixtures/parity.git',
             revision='v1', max_count=1, decorate='full');
----
[refs/tags/amended, refs/tags/binary, refs/tags/deleted, refs/tags/gitlink-bump, refs/tags/left, refs/tags/merged, refs/tags/multipath, refs/tags/note, refs/tags/padded-author, refs/tags/rename, refs/tags/right, refs/tags/typechange, refs/tags/v1, refs/tags/whitespace]	[refs/heads/master, refs/heads/side, refs/remotes/origin/main]

# Untagged commit: empty decorate, but still contained by later tags and master
query III
SELECT list_sort(decorate), list_sort(contained_tags), list_sort(contained_branches)
FROM git_log('./test/fixtures/parity.git',
             revision='gitlink-bump~1', max_count=1);
----
[]	[amended, gitlink-bump, multipath, padded-author]	[master]
