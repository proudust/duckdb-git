require duckdb_git

# author_timestamp matches git log %ai (commit amended: author and committer dates differ)
query I
SELECT author_timestamp FROM git_log('.', revision='7106f0ced64487e26de144c25c71fbf4447735dc', max_count=1);
----
2025-07-31 22:46:08+09
