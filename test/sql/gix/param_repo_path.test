# name: test/sql/gix/param_repo_path.test
# description: git_log repo_path with remote HTTP(S) URL (gix backend)
# group: [git]

require duckdb_git

require-env GIX_BACKEND 1

# Explicit backend; revision omitted so HEAD must resolve after clone
query I
SELECT count(*) FROM git_log('https://github.com/proudust/duckdb-git.git', max_count=3, backend='gix');
----
3

# Tip of unresolved HEAD carries the default-branch decorate
# (empty decorate here would mean clone left HEAD unset from the remote default branch)
query I
SELECT list_contains(decorate, 'main')
FROM git_log('https://github.com/proudust/duckdb-git.git', max_count=1, backend='gix');
----
true

# HEAD tip matches the remote default branch tip
query I
SELECT (
  SELECT commit_id FROM git_log('https://github.com/proudust/duckdb-git.git', max_count=1, backend='gix')
) = (
  SELECT commit_id FROM git_log('https://github.com/proudust/duckdb-git.git', revision='main', max_count=1, backend='gix')
);
----
true

# Second query exercises fetch against the existing cache
query I
SELECT count(*) FROM git_log('https://github.com/proudust/duckdb-git.git', max_count=3, backend='gix');
----
3

# Embedded credentials are rejected (anonymous HTTP(S) only)
statement error
SELECT count(*) FROM git_log('https://user:token@example.com/repo.git', max_count=1, backend='gix');
----
embedded credentials
