# name: test/sql/libgit/output_file_changes.test
# description: file_changes column and diff stats (libgit backend)
# group: [git]

require duckdb_git

# Multi-row walk: each commit's file_changes paths are independent.
# note → rename → gitlink-add, one path each.
query II
SELECT commit_id, list_transform(file_changes, lambda x: x.path)
FROM git_log('./test/fixtures/parity.git',
             revision='gitlink-bump~1',
             max_count=3)
ORDER BY author_timestamp ASC;
----
5b05f738e9af3deb3ae4c34cd99d1388b81be9ed	[note.txt]
95937d42365c812ebe6893e756cde1d0d86ae10b	[renamed.txt]
cc8160f1738b5b070eb029313f3c376364ad076f	[vendor]

# Multi-path commit followed by empty file_changes (same tree as parent).
query II
SELECT commit_id, list_sort(list_transform(file_changes, lambda x: x.path))
FROM git_log('./test/fixtures/parity.git',
             revision='amended',
             max_count=2)
ORDER BY author_timestamp ASC;
----
48b38a077c6ef03744be652baee901373a8ae06d	[multi_a.txt, multi_b.txt, vendor]
abe0518abd296b9b9a45755e12ec6ebec26c17a7	[]

# Full status set without path filter (other tests filter one path each)
query II
SELECT change.path, change.status
FROM (SELECT unnest(file_changes) AS change
      FROM git_log('./test/fixtures/parity.git',
                   revision='typechange',
                   max_count=1))
ORDER BY change.path;
----
data.bin	A
left.txt	D
space.txt	M
tracked.txt	T

# Typechange: git log --name-status shows a single T (not D+A); --numstat is 1/1
query IIII
SELECT change.path, change.status, change.add_lines, change.del_lines
FROM (SELECT unnest(file_changes) AS change
      FROM git_log('./test/fixtures/parity.git',
                   revision='typechange',
                   max_count=1))
WHERE change.path = 'tracked.txt';
----
tracked.txt	T	1	1

# Binary: git log --numstat prints "-	-"; we map that to NULL/NULL
query III
SELECT change.path, change.add_lines, change.del_lines
FROM (SELECT unnest(file_changes) AS change
      FROM git_log('./test/fixtures/parity.git',
                   revision='binary',
                   max_count=1))
WHERE change.path = 'data.bin';
----
data.bin	NULL	NULL

# Rename: single R entry with old_path (matches git show --name-status / --numstat)
query IIIII
SELECT change.path, change.old_path, change.status, change.add_lines, change.del_lines
FROM (SELECT unnest(file_changes) AS change
      FROM git_log('./test/fixtures/parity.git',
                   revision='rename',
                   max_count=1))
WHERE change.path = 'renamed.txt';
----
renamed.txt	note.txt	R	1	1

query I
SELECT COUNT(*) FROM (
  SELECT unnest(file_changes) AS change
  FROM git_log('./test/fixtures/parity.git',
               revision='rename',
               max_count=1)
) WHERE change.path = 'note.txt';
----
0

# Root commit: all blobs are Added; numstat is line count / 0 (same as git log --numstat)
query IIII
SELECT change.path, change.status, change.add_lines, change.del_lines
FROM (SELECT unnest(file_changes) AS change
      FROM git_log('./test/fixtures/parity.git',
                   revision='v1',
                   max_count=1))
ORDER BY change.path;
----
base.txt	A	1	0
space.txt	A	3	0
tracked.txt	A	1	0

# Ordinary blob: file_size is byte length; numstat is numeric (note.txt is 5 lines / 30 bytes)
query III
SELECT change.file_size, change.add_lines, change.del_lines
FROM (SELECT unnest(file_changes) AS change
      FROM git_log('./test/fixtures/parity.git',
                   revision='note',
                   max_count=1))
WHERE change.path = 'note.txt';
----
30	5	0

# Deletion: status=D; numstat 0/1; file_size from the removed blob
query IIII
SELECT change.status, change.add_lines, change.del_lines, change.file_size
FROM (SELECT unnest(file_changes) AS change
      FROM git_log('./test/fixtures/parity.git',
                   revision='deleted',
                   max_count=1))
WHERE change.path = 'left.txt';
----
D	0	1	2

# Submodule gitlink (A): numstat 1/0, file_size NULL
query IIII
SELECT change.status, change.add_lines, change.del_lines, change.file_size
FROM (SELECT unnest(file_changes) AS change
      FROM git_log('./test/fixtures/parity.git',
                   revision='gitlink-bump~1',
                   max_count=1))
WHERE change.path = 'vendor';
----
A	1	0	NULL

# Submodule gitlink (M): numstat 1/1, file_size NULL
query IIII
SELECT change.status, change.add_lines, change.del_lines, change.file_size
FROM (SELECT unnest(file_changes) AS change
      FROM git_log('./test/fixtures/parity.git',
                   revision='gitlink-bump',
                   max_count=1))
WHERE change.path = 'vendor';
----
M	1	1	NULL

# Missing blob while reading file_changes: same as git log --numstat
statement error
SELECT len(file_changes)
FROM git_log('./test/fixtures/missing-blob.git',
             max_count=1);
----
unable to read 3c59ec2b524832760260ac21a036a64e900d96c2
