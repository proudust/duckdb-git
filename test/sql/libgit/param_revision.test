# name: test/sql/libgit/param_revision.test
# description: revision parameter with multiple revspecs (libgit backend)
# group: [git]

require duckdb_git

# --- Ranges / LIST / empty tip / symmetric difference ---

# Linear range via tags returns commits reachable from rename but not note
query I
SELECT commit_id
FROM git_log('./test/fixtures/parity.git',
             revision='note..rename')
ORDER BY commit_id;
----
95937d42365c812ebe6893e756cde1d0d86ae10b

# LIST form: a positive tip plus a ^excluded revspec is equivalent to the range above
query I
SELECT commit_id
FROM git_log('./test/fixtures/parity.git',
             revision=['rename', '^note'])
ORDER BY commit_id;
----
95937d42365c812ebe6893e756cde1d0d86ae10b

# Merge range: left..merged is merged and the other side (right)
query I
SELECT commit_id
FROM git_log('./test/fixtures/parity.git',
             revision='left..merged')
ORDER BY commit_id;
----
28264d80ac316c97deb80c3ee52721ed6451e4b2
42e16c94127de3a9363f8a6f14fa5ca85856d8b4

# LIST form equivalent to left..merged
query I
SELECT commit_id
FROM git_log('./test/fixtures/parity.git',
             revision=['merged', '^left'])
ORDER BY commit_id;
----
28264d80ac316c97deb80c3ee52721ed6451e4b2
42e16c94127de3a9363f8a6f14fa5ca85856d8b4

# Symmetric difference (a...b) is explicitly unsupported
statement error
SELECT * FROM git_log('./test/fixtures/parity.git',
                      revision='note...rename');
----
symmetric difference ('note...rename') is not supported in revision; see git-log(1)

# Excluding everything with no positive tip returns empty (matching `git log ^rev`)
query I
SELECT count(*)
FROM git_log('./test/fixtures/parity.git',
             revision=['^note']);
----
0

# --- Tip resolution kinds (max_count=1) ---

# Lightweight tag
query I
SELECT commit_id
FROM git_log('./test/fixtures/parity.git',
             revision='rename', max_count=1);
----
95937d42365c812ebe6893e756cde1d0d86ae10b

# Annotated tag peels to the underlying commit
query I
SELECT commit_id
FROM git_log('./test/fixtures/parity.git',
             revision='v1', max_count=1);
----
ff09a62b129cc936f13bc67c5e2dba84f397c64b

# Local branch (HEAD)
query I
SELECT commit_id
FROM git_log('./test/fixtures/parity.git',
             revision='master', max_count=1);
----
abe0518abd296b9b9a45755e12ec6ebec26c17a7

# Local branch (side)
query I
SELECT commit_id
FROM git_log('./test/fixtures/parity.git',
             revision='side', max_count=1);
----
28264d80ac316c97deb80c3ee52721ed6451e4b2

# Remote-tracking ref
query I
SELECT commit_id
FROM git_log('./test/fixtures/parity.git',
             revision='origin/main', max_count=1);
----
42e16c94127de3a9363f8a6f14fa5ca85856d8b4

# Full tag ref
query I
SELECT commit_id
FROM git_log('./test/fixtures/parity.git',
             revision='refs/tags/rename', max_count=1);
----
95937d42365c812ebe6893e756cde1d0d86ae10b

# Full branch ref
query I
SELECT commit_id
FROM git_log('./test/fixtures/parity.git',
             revision='refs/heads/master', max_count=1);
----
abe0518abd296b9b9a45755e12ec6ebec26c17a7

# Abbreviated OID
query I
SELECT commit_id
FROM git_log('./test/fixtures/parity.git',
             revision='95937d4', max_count=1);
----
95937d42365c812ebe6893e756cde1d0d86ae10b

# Full SHA
query I
SELECT commit_id
FROM git_log('./test/fixtures/parity.git',
             revision='95937d42365c812ebe6893e756cde1d0d86ae10b', max_count=1);
----
95937d42365c812ebe6893e756cde1d0d86ae10b

# --- Parent / ancestor / peel ---

# First parent via ~
query I
SELECT commit_id
FROM git_log('./test/fixtures/parity.git',
             revision='rename~1', max_count=1);
----
5b05f738e9af3deb3ae4c34cd99d1388b81be9ed

# First-parent walk from a merge (~1 == ^1)
query I
SELECT commit_id
FROM git_log('./test/fixtures/parity.git',
             revision='merged~1', max_count=1);
----
fc021d9befa4cb7437bc815878ed20fd9ea37a2b

# Second parent of a merge
query I
SELECT commit_id
FROM git_log('./test/fixtures/parity.git',
             revision='merged^2', max_count=1);
----
28264d80ac316c97deb80c3ee52721ed6451e4b2

# Ancestor operator on a non-merge tip (parent is the merge)
query I
SELECT commit_id
FROM git_log('./test/fixtures/parity.git',
             revision='typechange~1', max_count=1);
----
42e16c94127de3a9363f8a6f14fa5ca85856d8b4

# Explicit peel of an annotated tag
query I
SELECT commit_id
FROM git_log('./test/fixtures/parity.git',
             revision='v1^{}', max_count=1);
----
ff09a62b129cc936f13bc67c5e2dba84f397c64b

query I
SELECT commit_id
FROM git_log('./test/fixtures/parity.git',
             revision='v1^{commit}', max_count=1);
----
ff09a62b129cc936f13bc67c5e2dba84f397c64b

# --- Elided ranges (.. defaults to HEAD; HEAD = master in this bare fixture) ---

# merged..HEAD: commits reachable from master but not merged
query I
SELECT count(*)
FROM git_log('./test/fixtures/parity.git',
             revision='merged..');
----
6

# HEAD..side is empty because side is reachable from master in this fixture
query I
SELECT count(*)
FROM git_log('./test/fixtures/parity.git',
             revision='..side');
----
0

# left..HEAD: hide left, tip is master
query I
SELECT count(*)
FROM git_log('./test/fixtures/parity.git',
             revision='left..');
----
8

# --- Rejects / unresolved ---

statement error
SELECT * FROM git_log('./test/fixtures/parity.git',
                      revision='^left..merged');
----
bad revision '^left..merged'

statement error
SELECT * FROM git_log('./test/fixtures/parity.git',
                      revision='^');
----
bad revision '^'

statement error
SELECT * FROM git_log('./test/fixtures/parity.git',
                      revision='no-such-ref');
----
ambiguous argument 'no-such-ref': unknown revision or path not in the working tree.

statement error
SELECT * FROM git_log('./test/fixtures/parity.git',
                      revision='^no-such-ref');
----
bad revision '^no-such-ref'

statement error
SELECT * FROM git_log('./test/fixtures/parity.git',
                      revision='left..typo');
----
ambiguous argument 'left..typo': unknown revision or path not in the working tree.
