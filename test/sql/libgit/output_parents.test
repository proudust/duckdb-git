# name: test/sql/libgit/output_parents.test
# description: parents column (libgit backend)
# group: [git]

require duckdb_git

# Multi-row walk: each commit's parents list is independent. Includes root ([]),
# single-parent commits, and a merge with ordered parents [B, C].
query II
SELECT commit_id, parents
FROM git_log('./test/fixtures/parity.git',
             revision='merged')
ORDER BY author_timestamp ASC;
