# name: test/sql/libgit/param_diff_merges.test
# description: diff_merges parameter (libgit backend)
# group: [git]

require duckdb_git

# Merge commit: default / off omit file_changes (same as git log --diff-merges=off)
query I
SELECT len(file_changes)
FROM git_log('./test/fixtures/parity.git',
             revision='merged',
             max_count=1);
----
0

query I
SELECT len(file_changes)
FROM git_log('./test/fixtures/parity.git',
             revision='merged',
             max_count=1, diff_merges='off');
----
0

# first_parent: diff against first parent (B) → right.txt added
query II
SELECT change.path, change.status
FROM (SELECT unnest(file_changes) AS change
      FROM git_log('./test/fixtures/parity.git',
                   revision='merged',
                   max_count=1, diff_merges='first_parent'))
ORDER BY change.path;
----
right.txt	A

# Git CLI spelling (first-parent) is also accepted
query II
SELECT change.path, change.status
FROM (SELECT unnest(file_changes) AS change
      FROM git_log('./test/fixtures/parity.git',
                   revision='merged',
                   max_count=1, diff_merges='first-parent'))
ORDER BY change.path;
----
right.txt	A

# Non-merge commit still returns file_changes with diff_merges='off'
query II
SELECT change.path, change.status
FROM (SELECT unnest(file_changes) AS change
      FROM git_log('./test/fixtures/parity.git',
                   revision='note',
                   max_count=1, diff_merges='off'))
ORDER BY change.path;
----
note.txt	A

# Invalid diff_merges value returns error
statement error
SELECT * FROM git_log('./test/fixtures/parity.git', diff_merges='invalid');
----
unknown diff_merges format: 'invalid' (expected 'off', 'first_parent', or 'first-parent')
